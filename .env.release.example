# Copy this file to .env.release, then fill BOTH digest values.
# From one successful main-push Actions summary, copy the 64 hexadecimal
# characters AFTER @sha256: for each service. Do not copy the commit SHA/tag.
# API reference: ghcr.io/mansaram90/adeguard-api@sha256:<64-hex-digest>
# Frontend reference: ghcr.io/mansaram90/adeguard-frontend@sha256:<64-hex-digest>
ADEGUARD_API_DIGEST=
ADEGUARD_FRONTEND_DIGEST=

# Optional registry/namespace overrides (normally leave commented).
# ADEGUARD_REGISTRY=ghcr.io
# ADEGUARD_NAMESPACE=mansaram90
